flowchart TD
    brief["用户 Brief + 输入快照 / 固定 Profile / Material / History"]
    audience["① Audience · 受众洞察 / 历史分析 / 相似内容 / 画像与历史"]
    research["② Research · 素材研究 / 素材检索 / 依据检查 / 证据缺口"]
    join["Join · 同快照汇合 / 两分支有效成功；失败不当空结果"]
    content["③ Content · 内容策划创作 / Strategy → Outline → Hook → Title → Body"]
    reviewer["④ Reviewer · 主编审核 / 分项分数 / 阻断问题 / 修改指令"]
    revise["Content.revise / 最早受影响阶段起重算"]
    supply["补充资料 / 新快照 / 重新验证两分支；预算不静默清零"]
    limit["自动返修上限 / 等待补料新运行或取消"]
    human["人工确认当前已审版本 / 接受 / 请求改稿 / 取消"]
    final["最终内容版本 / 用户接受后进入 History"]
    export["模板工具导出 / 确认版本 / 图片 / manifest"]
    done["完成交付 / 发布由人决定，指标手工回填"]
    cancelled["取消 / 保留候选稿 / 不升级为最终内容"]
    brief -->|"并行分支"| audience
    brief -->|"并行分支"| research
    audience -->|"AudienceInsight"| join
    research -->|"ResearchNotes"| join
    join -->|"完整性 / 版本通过"| content
    join -.->|"关键资料不足"| supply
    content -->|"Draft + 阶段产物"| reviewer
    reviewer -.->|"不通过，有额度"| revise
    revise -.->|"改稿"| content
    reviewer -->|"通过门槛"| human
    reviewer -.->|"关键证据不足"| supply
    reviewer -.->|"返修 2 轮仍不过"| limit
    limit -.->|"补料后明确新建 run"| supply
    supply -.->|"新快照重新分析"| brief
    limit -.->|"取消"| cancelled
    human -.->|"用户请求改稿"| revise
    human -.->|"取消"| cancelled
    human -->|"接受且版本有效"| final
    final -->|"有效审核版本"| export
    export -->|"文件齐全"| done
