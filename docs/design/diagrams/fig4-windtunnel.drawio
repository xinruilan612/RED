le="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=11;fontColor=#64748B;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n18" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b style=&quot;color:#1F3A5F&quot;&gt;ID 间接层&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7px;color:#64748B&quot;&gt;span_id：稿件槽位&lt;br&gt;excerpt_id：读稿证据片&lt;br&gt;evidence_id：材料证据片&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontSize=9;fontColor=#1F3A5F;fontStyle=0;align=left;verticalAlign=middle;dashed=0;arcSize=6;" vertex="1" parent="1"><mxGeometry x="24" y="380" width="300" height="84" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b style=&quot;color:#1F3A5F&quot;&gt;产出与边界&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7px;color:#64748B&quot;&gt;产出：问题清单 · 补丁 · 复查报告&lt;br&gt;边界：不替代真人判断&lt;br&gt;用途：成稿前验证 / 已有文案优化&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontSize=9;fontColor=#1F3A5F;fontStyle=0;align=left;verticalAlign=middle;dashed=0;arcSize=6;" vertex="1" parent="1"><mxGeometry x="336" y="380" width="300" height="84" as="geometry"/></mxCell></root></mxGraphModel>