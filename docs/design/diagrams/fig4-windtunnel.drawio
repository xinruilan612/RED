<mxGraphModel dx="660" dy="720" grid="0" gridSize="10" guides="0" tooltips="1" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="660" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n11" value="有迹 · 内容风洞的五个阶段" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=15;fontColor=#1F3A5F;fontStyle=1;align=left;verticalAlign=middle;dashed=0;arcSize=6;" vertex="1" parent="1"><mxGeometry x="24" y="10" width="612" height="22" as="geometry"/></mxCell><mxCell id="n12" value="用 ID 代替文本：模型只能选槽位与引用 ID，原文由程序提取" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=9;fontColor=#64748B;fontStyle=0;align=left;verticalAlign=middle;dashed=0;arcSize=6;" vertex="1" parent="1"><mxGeometry x="24" y="38" width="612" height="14" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;① 条件设定&lt;/b&gt;　&lt;font style=&quot;font-size:8px;color:#64748B&quot;&gt;作者写下这篇必须答对的问题（实测 12 条）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=9;fontColor=#1F3A5F;fontStyle=0;align=left;verticalAlign=middle;dashed=0;arcSize=6;" vertex="1" parent="1"><mxGeometry x="24" y="64" width="612" height="46" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;② 读稿&lt;/b&gt;　&lt;font style=&quot;font-size:8px;color:#64748B&quot;&gt;只看稿件本身 → pass / unclear；pass 必须给出 excerpt_id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=9;fontColor=#1F3A5F;fontStyle=0;align=left;verticalAlign=middle;dashed=0;arcSize=6;" vertex="1" parent="1"><mxGeometry x="24" y="126" width="612" height="46" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=11;fontColor=#64748B;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n13" tar