# Historical byte fingerprints must survive Windows checkout unchanged.
docs/submission/evidence/baseline-source/** -text

# POSIX launchers must not acquire CRLF when checked out on Windows.
*.sh text eol=lf
*.command text eol=lf
# Native command prompts use CRLF, without changing historical snapshots.
*.cmd text eol=crlf

# Exact official HTML evidence keeps upstream whitespace and download hashes.
docs/windtunnel/public_samples/license.html -whitespace
docs/windtunnel/public_samples/sources/*.html -whitespace
