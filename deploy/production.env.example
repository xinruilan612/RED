# Copy to /opt/youji/.env on the server only; chmod 600, owner youji.
# Literal KEY=value format; do not source this file as shell code.
DATABASE_URL=postgresql://youji:CHANGE_ME@127.0.0.1:5432/youji
PUBLIC_ORIGIN=https://CHANGE_ME.example.com
REGISTRATION_INVITE=CHANGE_ME
# Leave blank for the first simulated acceptance run.
DEEPSEEK_API_KEY=
WINDTUNNEL_ALLOW_LIVE=false
