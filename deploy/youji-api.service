[Unit]
Description=Youji website API
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=youji
Group=youji
WorkingDirectory=/opt/youji
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/opt/youji/runtime/venv/bin/python -m scripts.deploy_check --database
ExecStart=/opt/youji/runtime/venv/bin/python -m backend.api --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/youji/runtime

[Install]
WantedBy=multi-user.target
